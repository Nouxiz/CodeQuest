<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#1a1a2e">

    <!-- Header: Perfil / Nível -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Perfil"
            android:textColor="#7c4dff"
            android:textSize="10sp"
            android:fontFamily="@font/pressstart2p"/>

        <TextView
            android:id="@+id/tvNivelPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nível 1"
            android:textColor="#ffcc00"
            android:textSize="10sp"
            android:fontFamily="@font/pressstart2p"/>

    </LinearLayout>

    <!--
        ÍCONE DE PERSONAGEM PIXEL ART
        Substitui o View quadrado. Fundo escuro (#2a2a3e) com borda roxa,
        o VectorDrawable ic_pixel_character fica centralizado dentro do card.
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_avatar_card">

        <!-- Personagem centralizado -->
        <ImageView
            android:layout_width="120dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_pixel_character"
            android:scaleType="fitCenter"
            android:contentDescription="Avatar do personagem pixel art"/>

        <!-- Badge de nível no canto inferior direito -->
        <TextView
            android:id="@+id/tvBadgeNivel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="10dp"
            android:text="LVL 1"
            android:textColor="#ffcc00"
            android:textSize="7sp"
            android:fontFamily="@font/pressstart2p"
            android:background="#1a1a2e"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"/>

    </FrameLayout>

    <!-- Nome do usuário -->
    <TextView
        android:id="@+id/tvNomeUsuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nome do Usuário"
        android:textColor="#ffffff"
        android:textSize="14sp"
        android:fontFamily="@font/pressstart2p"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"/>

    <!-- Label XP Total -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="XP Total"
            android:textColor="#aaaaaa"
            android:textSize="9sp"
            android:fontFamily="@font/pressstart2p"/>

        <!-- Valor numérico ex: "50/100" -->
        <TextView
            android:id="@+id/tvXPNumerico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50/100"
            android:textColor="#ffcc00"
            android:textSize="9sp"
            android:fontFamily="@font/pressstart2p"/>

    </LinearLayout>

    <!-- Barra de XP -->
    <ProgressBar
        android:id="@+id/progressXP"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="50"
        android:progressTint="#7c4dff"
        android:progressBackgroundTint="#2a2a3e"
        android:layout_marginBottom="4dp"/>

    <!-- Texto auxiliar de XP -->
    <TextView
        android:id="@+id/tvXPInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="faltam 50 de XP para o nível 2"
        android:textColor="#aaaaaa"
        android:textSize="8sp"
        android:fontFamily="@font/pressstart2p"
        android:layout_gravity="end"
        android:layout_marginBottom="24dp"/>

    <!-- Título Estatísticas -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Estatísticas"
        android:textColor="#ffffff"
        android:textSize="10sp"
        android:fontFamily="@font/pressstart2p"
        android:layout_marginBottom="16dp"/>

    <!-- Divisor roxo -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#7c4dff"
        android:layout_marginBottom="16dp"/>

    <!-- Stats: Aulas / Acertos / Sequência -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="32dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvAulas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:fontFamily="@font/pressstart2p"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aula"
                android:textColor="#aaaaaa"
                android:textSize="8sp"
                android:fontFamily="@font/pressstart2p"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvAcertos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textColor="#00ff99"
                android:textSize="16sp"
                android:fontFamily="@font/pressstart2p"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Acertos"
                android:textColor="#aaaaaa"
                android:textSize="8sp"
                android:fontFamily="@font/pressstart2p"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvSequencia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1🔥"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:fontFamily="@font/pressstart2p"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sequência"
                android:textColor="#aaaaaa"
                android:textSize="8sp"
                android:fontFamily="@font/pressstart2p"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Botão voltar -->
    <Button
        android:id="@+id/btnVoltarMapa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Voltar para o Mapa"
        android:backgroundTint="#7c4dff"
        android:fontFamily="@font/pressstart2p"
        android:textSize="9sp"/>

</LinearLayout>