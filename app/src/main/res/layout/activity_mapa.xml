<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/imagem_fundo_fases"
        android:scaleType="centerCrop"/>

    <FrameLayout
        android:id="@+id/layoutFases"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="bottom"
        android:padding="8dp"
        android:background="#88000000">

        <TextView
            android:id="@+id/tvFasesConcluidas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Fases Concluídas: 0/5"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:fontFamily="@font/pressstart2p"/>

        <Button
            android:id="@+id/btnPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚔️ Perfil"
            android:textColor="#00ccff"
            android:textSize="12sp"
            android:backgroundTint="#88000033"
            android:fontFamily="@font/pressstart2p"
            android:padding="8dp"/>

    </LinearLayout>

</FrameLayout>