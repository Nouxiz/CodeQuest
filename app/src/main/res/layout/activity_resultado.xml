<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#1a1a2e">

    <TextView
        android:id="@+id/tvFaseConcluida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FASE CONCLUÍDA"
        android:textColor="#ffffff"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvParabens"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Parabéns!"
        android:textColor="#7c4dff"
        android:textSize="40sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvAprendeu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VOCÊ APRENDEU: LÓGICA"
        android:textColor="#00ff99"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvProximaAula"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PRÓXIMA AULA: ALGORITMOS"
        android:textColor="#aaaaaa"
        android:textSize="14sp"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btnProximaFase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Próxima Fase"
        android:backgroundTint="#7c4dff"/>

</LinearLayout>