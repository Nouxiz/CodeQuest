<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0d0d1a"
    android:padding="0dp">

    <!-- Header: Exercicio 1 + XP -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:background="#12122a">

        <TextView
            android:id="@+id/tvTituloExercicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exercicio 1"
            android:textColor="#ffffff"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>

        <TextView
            android:id="@+id/tvXP"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+10 XP"
            android:textColor="#7c4dff"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>

    <!-- Linha separadora -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2a2a4a"/>

    <!-- Conteúdo principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- Progresso -->
        <TextView
            android:id="@+id/tvProgressoExercicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Progresso 1/5"
            android:textColor="#888888"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="28dp"/>

        <!-- Pergunta -->
        <TextView
            android:id="@+id/tvPergunta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Qual a ordem correta para escovar os dentes?"
            android:textColor="#ffffff"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="32dp"/>

        <!-- Opção A -->
        <Button
            android:id="@+id/btnOpcaoA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A) Opção A"
            android:textColor="#cccccc"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:backgroundTint="#1e1e3a"
            android:layout_marginBottom="10dp"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <!-- Opção B -->
        <Button
            android:id="@+id/btnOpcaoB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="B) Opção B"
            android:textColor="#cccccc"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:backgroundTint="#1e1e3a"
            android:layout_marginBottom="10dp"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <!-- Opção C -->
        <Button
            android:id="@+id/btnOpcaoC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="C) Opção C"
            android:textColor="#cccccc"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:backgroundTint="#1e1e3a"
            android:layout_marginBottom="10dp"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <!-- Opção D -->
        <Button
            android:id="@+id/btnOpcaoD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="D) Opção D"
            android:textColor="#cccccc"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:backgroundTint="#1e1e3a"
            android:layout_marginBottom="10dp"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

    </LinearLayout>

    <!-- Botão Confirmar fixo no rodapé à direita -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/btnConfirmar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirmar"
            android:textColor="#ffffff"
            android:textSize="15sp"
            android:fontFamily="monospace"
            android:backgroundTint="#5533cc"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:stateListAnimator="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

    </LinearLayout>

</LinearLayout>